<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local-only opt-in daily check-in reminder -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Privacy guard: SobrieTree has NO network access of its own. Updates open in
         your browser, not in-app. These entries strip network/install/Bluetooth/
         nearby/location permissions from the merged manifest so neither this app
         nor any third-party library can ever hold them. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <application
        android:name=".SobrieTreeApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SobrieTree"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true"
            android:theme="@style/Theme.SobrieTree">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ProgressActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:theme="@style/Theme.SobrieTree" />
        <activity
            android:name=".JourneyActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:theme="@style/Theme.SobrieTree" />
        <activity
            android:name=".CalendarActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:theme="@style/Theme.SobrieTree" />
        <activity
            android:name=".SettingsActivity"
            android:launchMode="singleTop"
            android:exported="false"
            android:theme="@style/Theme.SobrieTree" />

        <!-- Handles the "Still alcohol-free" action on the check-in notification -->
        <receiver
            android:name=".CheckinActionReceiver"
            android:exported="false" />

        <!-- Home-screen widget: today's ring plus one-tap logging of the favourite.
             Exported because the launcher hosts it; its own log/undo actions are
             delivered to this same component and touch only local data. -->
        <receiver
            android:name=".SobrieTreeWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sobrietree.android.widget.LOG_FAVORITE" />
                <action android:name="com.sobrietree.android.widget.UNDO" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sobrietree_widget_info" />
        </receiver>
    </application>

</manifest> 