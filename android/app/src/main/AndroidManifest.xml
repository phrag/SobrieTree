<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local-only opt-in daily check-in reminder -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Opt-in over-the-air updates only. The app makes no network requests
         unless the user turns updates on in Settings; off by default. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Privacy guard: BrewLog never uses Bluetooth, nearby-device, Wi-Fi, or
         location access. Explicitly strip these from the merged manifest so a
         future third-party library can never introduce them. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />

    <application
        android:name=".BrewLogApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrewLog"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BrewLog">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ProgressActivity"
            android:exported="false"
            android:theme="@style/Theme.BrewLog" />
        <activity
            android:name=".JourneyActivity"
            android:exported="false"
            android:theme="@style/Theme.BrewLog" />
        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:theme="@style/Theme.BrewLog" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.BrewLog" />

        <!-- Handles the "Still alcohol-free" action on the check-in notification -->
        <receiver
            android:name=".CheckinActionReceiver"
            android:exported="false" />

        <!-- Serves the downloaded update APK to the system installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest> 