<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/ic_circle_background"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_info_details"
            app:tint="@color/blue_500" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/standard_drink_calculator"
            android:textAppearance="@style/TextAppearance.BrewLog.Headline"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <!-- Explanation -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/standard_drink_explanation"
        android:textAppearance="@style/TextAppearance.BrewLog.Body2"
        android:textColor="@color/text_secondary" />

    <!-- Volume Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/volume_ml"
        app:suffixText="ml"
        style="?attr/textInputStyle"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/input_background"
        app:hintTextColor="@color/text_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_calc_volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textColor="@color/text_on_surface"
            android:textColorHint="@color/text_hint" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ABV Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="@string/alcohol_percentage"
        app:suffixText="%"
        style="?attr/textInputStyle"
        app:boxBackgroundMode="filled"
        app:boxBackgroundColor="@color/input_background"
        app:hintTextColor="@color/text_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_calc_abv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:textColor="@color/text_on_surface"
            android:textColorHint="@color/text_hint" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Calculate Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_calculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/calculate"
        style="@style/Widget.BrewLog.Button" />

    <!-- Results Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        style="@style/Widget.BrewLog.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/result"
                android:textAppearance="@style/TextAppearance.BrewLog.Title"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_pure_alcohol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textAppearance="@style/TextAppearance.BrewLog.Body"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_result_uk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:textAppearance="@style/TextAppearance.BrewLog.Body"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_result_us"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.BrewLog.Body"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Standard Drink Reference -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/standard_drink_reference"
        android:textAppearance="@style/TextAppearance.BrewLog.Body2"
        android:textColor="@color/text_secondary" />

    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        style="@style/Widget.BrewLog.Button.Outlined" />

</LinearLayout>
