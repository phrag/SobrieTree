<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="240dp"
    android:layout_height="match_parent"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="@color/surface_variant"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:contentPadding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_edu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.TreeTotal.Body"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="Why the nightcap backfires" />

        <TextView
            android:id="@+id/tv_edu_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearance.TreeTotal.Body2"
            tools:text="Alcohol makes you fall asleep faster but wrecks the second half of the night." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/read_more"
            android:textAppearance="@style/TextAppearance.TreeTotal.Caption"
            android:textColor="@color/brand_primary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
