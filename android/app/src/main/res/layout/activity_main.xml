<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.TreeTotal"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_bar_background"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/app_bar_background"
            app:title="@string/app_name"
            app:subtitle="@string/app_tagline"
            app:titleTextColor="@color/app_bar_content"
            app:subtitleTextColor="@color/app_bar_content" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Initial Setup CTA (shown until onboarding complete) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_initial_setup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/start_setup"
                style="@style/Widget.TreeTotal.Button.Outlined"
                android:visibility="gone" />

            <!-- Hero: growth ring + today status -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.TreeTotal.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.treetotal.android.GrowthRingView
                            android:id="@+id/growth_ring"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/ring_description" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_today_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/today"
                                android:textAppearance="@style/TextAppearance.TreeTotal.Caption" />

                            <TextView
                                android:id="@+id/tv_ring_progress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="2"
                                android:ellipsize="end"
                                app:autoSizeTextType="uniform"
                                app:autoSizeMinTextSize="15sp"
                                app:autoSizeMaxTextSize="24sp"
                                app:autoSizeStepGranularity="1sp"
                                android:textAppearance="@style/TextAppearance.TreeTotal.Headline"
                                tools:text="Alcohol-free so far" />

                            <TextView
                                android:id="@+id/tv_streak"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="@style/TextAppearance.TreeTotal.Body2"
                                android:textColor="@color/state_positive"
                                tools:text="🌱 5-day streak · best 8" />

                            <TextView
                                android:id="@+id/tv_total_af"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.TreeTotal.Body2"
                                tools:text="23 alcohol-free days · 🛡 2" />

                        </LinearLayout>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_encouragement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Encourage"
                        tools:text="Nothing logged today — your ring is full and your body is repairing." />

                    <!-- This week: 7 day dots populated in code -->
                    <LinearLayout
                        android:id="@+id/week_dots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Craving-time support (shown only during the high-risk window) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_craving_support"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/brand_primary_container"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:contentPadding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_growth_stage_2"
                        android:contentDescription="@string/high_risk_card_label" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/high_risk_card_label"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Caption"
                            android:textColor="@color/brand_primary" />

                        <TextView
                            android:id="@+id/tv_craving_support"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Encourage"
                            android:textColor="@color/text_primary"
                            tools:text="This is usually when the pull is strongest. It passes in about 20 minutes." />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Progress tiles row 1: alcohol-free days this week, reduction vs. usual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tile_af_week"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.TreeTotal.Card"
                    app:contentPadding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_af_week"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Title"
                            android:textColor="@color/state_positive"
                            tools:text="3 / 7" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/tile_af_this_week"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Caption" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tile_reduction"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.TreeTotal.Card"
                    app:contentPadding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_reduction_week"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Title"
                            android:textColor="@color/state_positive"
                            tools:text="40%" />

                        <TextView
                            android:id="@+id/tv_reduction_week_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/less_than_baseline"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Caption" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Progress tiles row 2: money and calories not spent -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tile_money"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.TreeTotal.Card"
                    app:contentPadding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_money_saved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Title"
                            android:textColor="@color/state_positive"
                            tools:text="120" />

                        <TextView
                            android:id="@+id/tv_money_caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/tile_money_saved"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Caption" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tile_calories"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    style="@style/Widget.TreeTotal.Card"
                    app:contentPadding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_calories_saved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Title"
                            android:textColor="@color/state_positive"
                            tools:text="4,300" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/tile_calories_avoided"
                            android:textAppearance="@style/TextAppearance.TreeTotal.Caption" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Latest recovery stage: most recent health milestone reached -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.TreeTotal.Card"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recovery_stage_title"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Caption"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_recovery_stage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Body"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold"
                        tools:text="1 week - Energy returns" />

                    <TextView
                        android:id="@+id/tv_recovery_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Body2"
                        android:textColor="@color/text_secondary"
                        tools:text="Better-quality sleep compounds: steadier energy, better hydration and sharper focus." />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/view_full_timeline"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Caption"
                        android:textColor="@color/brand_primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quick log -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                style="@style/Widget.TreeTotal.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="@string/log_a_drink"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/log_card_hint"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Caption"
                        android:textColor="@color/text_secondary" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="false"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp">
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/quick_add_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isScrollContainer="false"
                            app:singleLine="true"
                            app:singleSelection="false" />
                    </HorizontalScrollView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_drink_tile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAllCaps="false"
                        android:text="@string/log_a_custom_drink"
                        style="@style/Widget.TreeTotal.Button" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_manage_drinks_tile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAllCaps="false"
                        android:text="@string/edit_my_drinks"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        style="@style/Widget.TreeTotal.Button.Text" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_manage_goals_baseline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minHeight="48dp"
                        android:minWidth="0dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textAllCaps="false"
                        android:text="@string/manage_goals_baseline"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        style="@style/Widget.TreeTotal.Button.Text" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recent entries -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.TreeTotal.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/recent_entries"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Title" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_beer_entry" />

                    <TextView
                        android:id="@+id/empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:text="@string/no_entries_yet"
                        android:textAppearance="@style/TextAppearance.TreeTotal.Body"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        app:menu="@menu/menu_bottom"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
