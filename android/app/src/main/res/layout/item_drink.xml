<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@color/surface">

    <ImageView
        android:id="@+id/iv_favorite"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_star"
        android:contentDescription="Favorite"
        android:layout_marginEnd="8dp"
        app:tint="@color/brand_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_drink_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drink name"
            android:textAppearance="@style/TextAppearance.TreeTotal.Body"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_drink_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="500ml • 5.0% ABV"
            android:textAppearance="@style/TextAppearance.TreeTotal.Caption"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_edit"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="Edit"
        android:layout_marginEnd="12dp"
        app:tint="@color/brand_primary" />

    <ImageView
        android:id="@+id/iv_delete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="Delete"
        app:tint="@color/error" />

</LinearLayout> 