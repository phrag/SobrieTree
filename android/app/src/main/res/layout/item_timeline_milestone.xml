<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/v_dot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/dot_circle"
        android:backgroundTint="@color/state_positive" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_milestone_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SobrieTree.Body"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            tools:text="1 week — Energy returns" />

        <TextView
            android:id="@+id/tv_milestone_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SobrieTree.Body2"
            tools:text="Better-quality sleep compounds: steadier energy and sharper focus." />

        <TextView
            android:id="@+id/tv_milestone_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SobrieTree.Caption"
            android:textColor="@color/state_positive"
            tools:text="Reached Jul 12" />

    </LinearLayout>

</LinearLayout>
