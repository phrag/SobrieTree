<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tv_stat_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.TreeTotal.Title"
        tools:text="This week" />

    <TextView
        android:id="@+id/tv_stat_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.TreeTotal.Caption"
        tools:text="13 Jul – 15 Jul · 3 days" />

    <TextView
        android:id="@+id/tv_stat_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.TreeTotal.Body"
        tools:text="2 drinks · 5 units · 1 dry day" />

    <TextView
        android:id="@+id/tv_stat_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.TreeTotal.Caption"
        tools:text="1.7 units a day on average · 67% below your usual" />

</LinearLayout>
