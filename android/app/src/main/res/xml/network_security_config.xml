<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- HTTPS only (no cleartext). The app makes no network requests unless the
         user opts into updates; that flow talks only to GitHub over HTTPS. -->
</network-security-config>


