<?xml version="1.0" encoding="utf-8"?>
<!-- Text of a segmented choice: the selected half speaks in the brand color,
     the other stays quiet. Both tokens are remapped for night. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_primary" android:state_checked="true" />
    <item android:color="@color/text_secondary" />
</selector>
