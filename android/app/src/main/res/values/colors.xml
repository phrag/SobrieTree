<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         BrewLog design tokens - calm, health-focused identity.
         Rule: no red for consumption states; error is reserved for
         destructive actions and input validation only.
         ============================================================ -->

    <!-- Brand -->
    <color name="brand_primary">#00695C</color>
    <color name="brand_primary_dark">#00453B</color>
    <color name="brand_primary_light">#439889</color>
    <color name="brand_primary_container">#D9EFE9</color>
    <color name="brand_secondary">#C89B6C</color>
    <color name="brand_secondary_dark">#A87F50</color>

    <!-- Backgrounds and surfaces -->
    <color name="background">#F6F9F7</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#ECF2EE</color>
    <color name="card_background">#FFFFFF</color>
    <color name="input_background">#F0F5F1</color>

    <!-- Text -->
    <color name="text_primary">#182420</color>
    <color name="text_secondary">#54655E</color>
    <color name="text_hint">#93A39B</color>
    <color name="text_on_primary">#FFFFFF</color>
    <color name="text_on_surface">#182420</color>

    <!-- Consumption states (never red) -->
    <color name="state_positive">#2E7D32</color>
    <color name="state_positive_container">#E2F1E3</color>
    <color name="state_caution">#B98A00</color>
    <color name="state_caution_container">#F6EDD4</color>
    <color name="state_neutral">#607D8B</color>
    <color name="state_neutral_container">#ECEFF1</color>

    <!-- Destructive / validation only -->
    <color name="error">#C62828</color>
    <color name="success">#2E7D32</color>
    <color name="warning">#B98A00</color>
    <color name="info">#00695C</color>

    <!-- Growth ring + plant -->
    <color name="ring_track">#E2EAE5</color>
    <color name="ring_progress_start">#43A047</color>
    <color name="ring_progress_end">#D8A200</color>
    <color name="ring_af_glow">#66BB6A</color>
    <color name="growth_leaf">#4CAF50</color>
    <color name="growth_stem">#33691E</color>
    <color name="growth_soil">#8D6E63</color>

    <!-- Charts -->
    <color name="chart_actual">#26A69A</color>
    <color name="chart_baseline">#8D8D8D</color>
    <color name="chart_goal">#2E7D32</color>
    <color name="chart_grid">#26607D8B</color>
    <color name="chart_axis_text">#54655E</color>

    <!-- Dividers and borders -->
    <color name="divider">#E0E8E3</color>
    <color name="border">#DCE6E0</color>

    <!-- App bar (stays deep teal in light mode, surface-dark at night) -->
    <color name="app_bar_background">#00695C</color>
    <color name="app_bar_content">#FFFFFF</color>

    <!-- Common -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>

    <!-- Badge tiers -->
    <color name="badge_earned">#00695C</color>
    <color name="badge_locked">#B8C4BE</color>

    <!-- ============================================================
         Legacy aliases - old names still referenced by layouts/code.
         They now point at the new palette; removed as call sites
         migrate.
         ============================================================ -->
    <color name="primary">@color/brand_primary</color>
    <color name="primary_dark">@color/brand_primary_dark</color>
    <color name="primary_light">@color/brand_primary_light</color>
    <color name="accent">@color/brand_secondary</color>
    <color name="accent_dark">@color/brand_secondary_dark</color>
    <color name="primaryBlue">@color/brand_primary</color>
    <color name="green_500">@color/state_positive</color>
    <color name="blue_50">@color/brand_primary_container</color>
    <color name="blue_100">@color/brand_primary_container</color>
    <color name="blue_200">@color/brand_primary_light</color>
    <color name="blue_300">@color/brand_primary_light</color>
    <color name="blue_400">@color/brand_primary</color>
    <color name="blue_500">@color/brand_primary</color>
    <color name="blue_600">@color/brand_primary</color>
    <color name="blue_700">@color/brand_primary_dark</color>
    <color name="blue_800">@color/brand_primary_dark</color>
    <color name="blue_900">@color/brand_primary_dark</color>
    <color name="purple_500">@color/brand_primary</color>
    <color name="purple_700">@color/brand_primary_dark</color>
    <color name="teal_200">@color/brand_primary_light</color>
    <color name="teal_700">@color/brand_primary_dark</color>

    <!-- Dark palette fallbacks for lint (actual night values in values-night) -->
    <color name="dark_background">#101613</color>
    <color name="dark_surface">#161E1A</color>
    <color name="dark_surface_variant">#1F2A24</color>
    <color name="dark_card_background">#1B2520</color>
    <color name="dark_text_primary">#ECF2EE</color>
    <color name="dark_text_secondary">#A9B8B0</color>
    <color name="dark_text_hint">#6F7F76</color>
    <color name="dark_text_on_surface">#ECF2EE</color>
</resources>
